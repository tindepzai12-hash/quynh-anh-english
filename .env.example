PORT=8765
APP_ORIGIN=http://127.0.0.1:8765
PYTHON_BIN=python3
# Obtain from the selected Supabase project. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
GOOGLE_OAUTH_ENABLED=false
FACEBOOK_OAUTH_ENABLED=false
# Set true only after custom SMTP and real verification/recovery delivery pass.
AUTH_EMAIL_DELIVERY_READY=false

# Server-side only. Select a currently available Gemini model in AI Studio.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional alternative provider
OPENAI_API_KEY=
OPENAI_MODEL=
